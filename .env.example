APP_ENV=development
SERVICE_NAME=socialpilot-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://<host>:6379/0
REDIS_PORT=6379
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://<host>:6379/1
CELERY_RESULT_BACKEND=redis://<host>:6379/2
CELERY_TASK_TIMEOUT_SECONDS=300
MEDIA_MAX_LONG_EDGE=3840
MEDIA_MAX_SHORT_EDGE=2160
MEDIA_MAX_TOTAL_PIXELS=8294400
MEDIA_PROXY_MAX_LONG_EDGE=1280
MEDIA_PROXY_MAX_SHORT_EDGE=720
MEDIA_THUMBNAIL_MAX_LONG_EDGE=640
MEDIA_THUMBNAIL_MAX_SHORT_EDGE=640
MEDIA_MAX_DERIVATIVE_BYTES=52428800
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
SCENE_MIN_DURATION_MS=500
SCENE_MAX_COUNT=500
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120
MEDIA_MAX_EXTRACTED_AUDIO_BYTES=115200044
ASR_TIMEOUT_SECONDS=120
TRANSCRIPT_MAX_SEGMENT_COUNT=2000
TRANSCRIPT_MAX_SEGMENT_CHARS=4000
TRANSCRIPT_MAX_TOTAL_CHARS=1000000
TRANSCRIPT_MIN_CONFIDENCE=0
IDENTITY_ADAPTER=local
LOCAL_IDENTITY_SIGNING_KEY=<non-production-local-signing-key>
API_HOST_PORT=8000
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
