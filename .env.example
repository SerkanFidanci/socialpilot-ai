APP_ENV=development
SERVICE_NAME=socialpilot-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://<host>:6379/0
REDIS_PORT=6379
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://<host>:6379/1
CELERY_RESULT_BACKEND=redis://<host>:6379/2
CELERY_TASK_TIMEOUT_SECONDS=960
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
WORKER_DRAIN_BATCH_SIZE=10
WORKER_TEMP_ROOT=/tmp/socialpilot-worker
CELERY_BEAT_OUTBOX_INTERVAL_SECONDS=10
CELERY_BEAT_MEDIA_DRAIN_INTERVAL_SECONDS=30
CELERY_BEAT_RECOVERY_INTERVAL_SECONDS=60
PROCESSING_SUMMARY_MAX_ITEMS=500
MEDIA_MAX_LONG_EDGE=3840
MEDIA_MAX_SHORT_EDGE=2160
MEDIA_MAX_TOTAL_PIXELS=8294400
MEDIA_PROXY_MAX_LONG_EDGE=1280
MEDIA_PROXY_MAX_SHORT_EDGE=720
MEDIA_THUMBNAIL_MAX_LONG_EDGE=640
MEDIA_THUMBNAIL_MAX_SHORT_EDGE=640
MEDIA_MAX_DERIVATIVE_BYTES=52428800
MEDIA_PROBE_TIMEOUT_SECONDS=60
MEDIA_DERIVATIVE_TIMEOUT_SECONDS=120
MEDIA_TECHNICAL_JOB_TIMEOUT_SECONDS=315
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
SCENE_MIN_DURATION_MS=500
SCENE_MAX_COUNT=500
SCENE_DETECTION_TIMEOUT_SECONDS=60
SCENE_SPEECH_JOB_TIMEOUT_SECONDS=315
MEDIA_JOB_PERSISTENCE_TIMEOUT_SECONDS=15
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120
MEDIA_MAX_EXTRACTED_AUDIO_BYTES=115200044
ASR_TIMEOUT_SECONDS=120
TRANSCRIPT_MAX_SEGMENT_COUNT=2000
TRANSCRIPT_MAX_SEGMENT_CHARS=4000
TRANSCRIPT_MAX_TOTAL_CHARS=1000000
TRANSCRIPT_MIN_CONFIDENCE=0
VIDEO_UNDERSTANDING_MAX_SUMMARY_CHARS=1000
VIDEO_UNDERSTANDING_MAX_VISUAL_DESCRIPTION_CHARS=2000
VIDEO_UNDERSTANDING_MAX_TRANSCRIPT_CONTEXT_CHARS=4000
VIDEO_UNDERSTANDING_MAX_LABELS=20
VIDEO_UNDERSTANDING_MAX_OBJECTS=30
VIDEO_UNDERSTANDING_MAX_ACTIONS=20
VIDEO_UNDERSTANDING_MAX_VISIBLE_TEXT_ITEMS=20
VIDEO_UNDERSTANDING_MAX_VISIBLE_TEXT_ITEM_CHARS=500
VIDEO_UNDERSTANDING_MAX_JSON_BYTES=32768
VIDEO_UNDERSTANDING_MAX_JSON_DEPTH=5
VIDEO_UNDERSTANDING_MIN_CONFIDENCE=0
VIDEO_UNDERSTANDING_NONVISUAL_MAX_CONFIDENCE=0.5
FRAME_EXTRACTION_TIMEOUT_SECONDS=30
VIDEO_UNDERSTANDING_FRAMES_PER_SCENE=3
VIDEO_UNDERSTANDING_MAX_FRAMES_PER_ASSET=50
VIDEO_UNDERSTANDING_MAX_FRAME_WIDTH=1280
VIDEO_UNDERSTANDING_MAX_FRAME_HEIGHT=720
VIDEO_UNDERSTANDING_MAX_FRAME_BYTES=1048576
VIDEO_UNDERSTANDING_FRAME_BOUNDARY_OFFSET_MS=100
VIDEO_UNDERSTANDING_TIMEOUT_SECONDS=60
VIDEO_UNDERSTANDING_JOB_BASE_TIMEOUT_SECONDS=15
VIDEO_UNDERSTANDING_JOB_PER_SCENE_TIMEOUT_SECONDS=150
VIDEO_UNDERSTANDING_JOB_PERSISTENCE_TIMEOUT_SECONDS=15
VIDEO_UNDERSTANDING_JOB_MAX_TIMEOUT_SECONDS=900
JOB_TIMEOUT_GRACE_SECONDS=15
VIDEO_UNDERSTANDING_MAX_ATTEMPTS=3
IDENTITY_ADAPTER=local
LOCAL_IDENTITY_SIGNING_KEY=<non-production-local-signing-key>
# fake keeps the byte-free in-process adapter; s3 is required outside development.
STORAGE_ADAPTER=fake
S3_ENDPOINT_URL=http://<storage-host>:9000
# Part URLs are signed for the address the client contacts, not the server-side endpoint.
S3_PRESIGN_ENDPOINT_URL=http://<client-reachable-storage-host>:9000
S3_REGION=us-east-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<non-production-storage-access-key-id>
S3_SECRET_ACCESS_KEY=<non-production-storage-secret-access-key>
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_SECONDS=15
S3_VERIFICATION_TIMEOUT_SECONDS=120
S3_PRESIGN_TTL_SECONDS=900
API_HOST_PORT=8000
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001
