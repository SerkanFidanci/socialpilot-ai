APP_ENV=development
SERVICE_NAME=socialpilot-api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://<host>:6379/0
REDIS_PORT=6379
DATABASE_CONNECT_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
CELERY_BROKER_URL=redis://<host>:6379/1
CELERY_RESULT_BACKEND=redis://<host>:6379/2
CELERY_TASK_TIMEOUT_SECONDS=960
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=900
WORKER_DRAIN_BATCH_SIZE=10
WORKER_TEMP_ROOT=/tmp/socialpilot-worker
CELERY_BEAT_OUTBOX_INTERVAL_SECONDS=10
CELERY_BEAT_MEDIA_DRAIN_INTERVAL_SECONDS=30
CELERY_BEAT_RECOVERY_INTERVAL_SECONDS=60
PROCESSING_SUMMARY_MAX_ITEMS=500
MEDIA_MAX_LONG_EDGE=3840
MEDIA_MAX_SHORT_EDGE=2160
MEDIA_MAX_TOTAL_PIXELS=8294400
MEDIA_PROXY_MAX_LONG_EDGE=1280
MEDIA_PROXY_MAX_SHORT_EDGE=720
MEDIA_THUMBNAIL_MAX_LONG_EDGE=640
MEDIA_THUMBNAIL_MAX_SHORT_EDGE=640
MEDIA_MAX_DERIVATIVE_BYTES=52428800
MEDIA_PROBE_TIMEOUT_SECONDS=60
MEDIA_DERIVATIVE_TIMEOUT_SECONDS=120
MEDIA_TECHNICAL_JOB_TIMEOUT_SECONDS=315
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
SCENE_MIN_DURATION_MS=500
SCENE_MAX_COUNT=500
SCENE_DETECTION_TIMEOUT_SECONDS=60
SCENE_SPEECH_JOB_TIMEOUT_SECONDS=315
MEDIA_JOB_PERSISTENCE_TIMEOUT_SECONDS=15
AUDIO_EXTRACTION_TIMEOUT_SECONDS=120
MEDIA_MAX_EXTRACTED_AUDIO_BYTES=115200044
ASR_TIMEOUT_SECONDS=120
TRANSCRIPT_MAX_SEGMENT_COUNT=2000
TRANSCRIPT_MAX_SEGMENT_CHARS=4000
TRANSCRIPT_MAX_TOTAL_CHARS=1000000
TRANSCRIPT_MIN_CONFIDENCE=0
VIDEO_UNDERSTANDING_MAX_SUMMARY_CHARS=1000
VIDEO_UNDERSTANDING_MAX_VISUAL_DESCRIPTION_CHARS=2000
VIDEO_UNDERSTANDING_MAX_TRANSCRIPT_CONTEXT_CHARS=4000
VIDEO_UNDERSTANDING_MAX_LABELS=20
VIDEO_UNDERSTANDING_MAX_OBJECTS=30
VIDEO_UNDERSTANDING_MAX_ACTIONS=20
VIDEO_UNDERSTANDING_MAX_VISIBLE_TEXT_ITEMS=20
VIDEO_UNDERSTANDING_MAX_VISIBLE_TEXT_ITEM_CHARS=500
VIDEO_UNDERSTANDING_MAX_JSON_BYTES=32768
VIDEO_UNDERSTANDING_MAX_JSON_DEPTH=5
VIDEO_UNDERSTANDING_MIN_CONFIDENCE=0
VIDEO_UNDERSTANDING_NONVISUAL_MAX_CONFIDENCE=0.5
FRAME_EXTRACTION_TIMEOUT_SECONDS=30
VIDEO_UNDERSTANDING_FRAMES_PER_SCENE=3
VIDEO_UNDERSTANDING_MAX_FRAMES_PER_ASSET=50
VIDEO_UNDERSTANDING_MAX_FRAME_WIDTH=1280
VIDEO_UNDERSTANDING_MAX_FRAME_HEIGHT=720
VIDEO_UNDERSTANDING_MAX_FRAME_BYTES=1048576
VIDEO_UNDERSTANDING_FRAME_BOUNDARY_OFFSET_MS=100
VIDEO_UNDERSTANDING_TIMEOUT_SECONDS=60
VIDEO_UNDERSTANDING_JOB_BASE_TIMEOUT_SECONDS=15
VIDEO_UNDERSTANDING_JOB_PER_SCENE_TIMEOUT_SECONDS=150
VIDEO_UNDERSTANDING_JOB_PERSISTENCE_TIMEOUT_SECONDS=15
VIDEO_UNDERSTANDING_JOB_MAX_TIMEOUT_SECONDS=900
JOB_TIMEOUT_GRACE_SECONDS=15
VIDEO_UNDERSTANDING_MAX_ATTEMPTS=3
IDENTITY_ADAPTER=local
LOCAL_IDENTITY_SIGNING_KEY=<non-production-local-signing-key>
# fake keeps the byte-free in-process adapter; s3 is required outside development.
STORAGE_ADAPTER=fake
S3_ENDPOINT_URL=http://<storage-host>:9000
# Part URLs are signed for the address the client contacts, not the server-side endpoint.
S3_PRESIGN_ENDPOINT_URL=http://<client-reachable-storage-host>:9000
S3_REGION=us-east-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<non-production-storage-access-key-id>
S3_SECRET_ACCESS_KEY=<non-production-storage-secret-access-key>
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_SECONDS=15
S3_VERIFICATION_TIMEOUT_SECONDS=120
S3_PRESIGN_TTL_SECONDS=900

# --- Script generation (W13, PRD §17) ------------------------------------------------------
# `fake` is the fixture scenario writer used in development and tests. `disabled` declines
# every call with 503 SCRIPT_GENERATION_NOT_CONFIGURED. Production is swapped onto `disabled`
# by the factory rather than refused at boot: fixture marketing copy is fluent enough for a
# human to approve and publish, so it must never be served as real content — but one
# unconfigured capability should not take the whole application down.
SCRIPT_GENERATION_ADAPTER=fake
SCRIPT_GENERATION_TIMEOUT_SECONDS=60
# Per-call ceiling in the adapter's own minor units, checked BEFORE the provider is called.
# Zero is the safe default and is deliberate: a route that costs money is refused until
# somebody sets a budget for it, which is the right direction for a knob nobody turned.
SCRIPT_GENERATION_MAX_COST_MINOR=0
# Bump when the routing table changes; the value is stored on each script's route snapshot,
# so a script stays attributable to the routing decision that produced it (ADR-007).
SCRIPT_GENERATION_ROUTE_REVISION=1
SCRIPT_GENERATION_QUALITY_TIER=standard
# Recorded on the route snapshot for data-residency accounting; set it once a real provider
# and region are chosen.
SCRIPT_GENERATION_DATA_REGION=unspecified
# Ceilings on what a provider may return and on what may be sent to it. The note limits bound
# untrusted media text (§17.5): transcript and on-screen text travel as data, never merged
# into the instruction.
SCRIPT_GENERATION_MAX_OUTPUT_BYTES=16384
SCRIPT_GENERATION_MAX_SOURCE_ASSETS=5
SCRIPT_GENERATION_MAX_NOTES=20
SCRIPT_GENERATION_MAX_NOTE_CHARS=400
SCRIPT_GENERATION_MAX_BRIEF_CHARS=400
SCRIPT_GENERATION_TARGET_DURATION_MS=20000

# --- Text to speech (W15, PRD §17.3) -------------------------------------------------------
# `fake` writes a real but obviously synthetic tone file so the pipeline — including the
# ffprobe measurement — runs end to end at zero provider cost. `disabled` declines every call
# with 503 TTS_NOT_CONFIGURED. Production is swapped onto `disabled` by the factory rather than
# refused at boot: synthesized speech reading already-approved copy is publishable, and an
# audience cannot tell a fixture voice from a purchased one by listening.
TTS_ADAPTER=fake
TTS_TIMEOUT_SECONDS=60
# One voiceover is several calls and this endpoint answers synchronously, so the whole run
# carries its own ceiling on top of the per-call one. Must cover one call plus its measurement.
TTS_TOTAL_TIMEOUT_SECONDS=180
TTS_PROBE_TIMEOUT_SECONDS=30
# Per-call ceiling in the adapter's own minor units, checked BEFORE any provider is called; the
# whole run's estimate is checked against it too. Zero is the safe default and is deliberate.
TTS_MAX_COST_MINOR=0
# Bump when the routing table changes; stored on each voiceover's route snapshot (ADR-007).
TTS_ROUTE_REVISION=1
TTS_QUALITY_TIER=standard
# Recorded on the route snapshot for data-residency accounting.
TTS_DATA_REGION=unspecified
# The voice used when a request does not name one. Must be a code in VOICE_PROFILES
# (app/modules/content/tts.py); an unknown value makes every default-voice request answer
# 409 VOICEOVER_VOICE_PROFILE_NOT_CONFIGURED.
TTS_DEFAULT_VOICE_PROFILE=tr-warm-v1
# Ceiling on the audio one line may produce, before it is written.
TTS_MAX_AUDIO_BYTES=20971520

API_HOST_PORT=8000
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
MINIO_HOST_PORT=59000
MINIO_CONSOLE_HOST_PORT=59001

# --- Off-server encrypted backup (ADR-013) -------------------------------------------------
# Consumed by scripts/backup_db.py and scripts/restore_check.py; reuses the S3_* object-storage
# config above for the backup destination. Not read by the app itself.
# Symmetric passphrase for the openssl AES-256-CBC backup (>= 16 chars). NEVER commit the real
# value; store it in the server's secret manager, not in git.
BACKUP_ENCRYPTION_KEY=<backup-encryption-passphrase-min-16-chars>
# Key prefix under S3_BUCKET where dated backups are written (trailing slash optional).
BACKUP_S3_PREFIX=backups/
# Retention: keep every backup from the last N days, plus one per ISO week for M weeks.
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_WEEKS=8
# Tool paths on the backup host (defaults assume they are on PATH).
BACKUP_PG_DUMP_BINARY=pg_dump
BACKUP_PSQL_BINARY=psql
BACKUP_OPENSSL_BINARY=openssl
BACKUP_S3_TIMEOUT_SECONDS=300
# Restore rehearsal target: a THROWAWAY database, never production. Loaded from scratch each run.
RESTORE_CHECK_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<scratch-db>
# Optional: pin a specific backup object key to restore; unset restores the newest.
RESTORE_CHECK_BACKUP_KEY=
