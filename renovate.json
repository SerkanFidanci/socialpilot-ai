{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One grouped weekly PR for the Python backend dependencies; uv.lock is refreshed with each.",
      "matchManagers": ["pep621"],
      "groupName": "python backend dependencies"
    },
    {
      "description": "Group CI action pins and container base-image bumps together.",
      "matchManagers": ["github-actions", "dockerfile"],
      "groupName": "ci and container images"
    },
    {
      "description": "SQLAlchemy is deliberately held at 2.0 until 2.1 leaves beta (see services/api/pyproject.toml).",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["sqlalchemy"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
